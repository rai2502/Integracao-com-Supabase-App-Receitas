# ============================================================
# Fogo Baixo — variáveis de ambiente (Supabase)
# ============================================================
# 1. Copie este arquivo para ".env.local"  (cp .env.example .env.local)
# 2. Preencha os valores abaixo com os dados do SEU projeto Supabase:
#      Painel do Supabase > Project Settings > API
# 3. O ".env.local" NUNCA deve ser commitado — ele já está no .gitignore.
#
# Importante: como este é um projeto Vite, toda variável que precisa
# chegar até o código do navegador tem que começar com o prefixo VITE_.
# Sem esse prefixo, o Vite não expõe a variável e import.meta.env fica
# undefined — essa é a "regra de ouro" da Aula 08.
# ============================================================

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLIC_AQUI
